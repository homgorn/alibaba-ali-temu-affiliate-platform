# Cloudflare Pages — build configuration
# Root directory of the Pages project: apps/web
# Build command:                  pnpm --filter @affiliate/web build
# Build output directory:         /out
#
# _headers — security + cache defaults for static export.
# Per-page markdown Link headers are emitted by functions/_middleware.ts,
# which runs at the edge (SPEC-004 FR-10).

# Security defaults on every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Static assets are fingerprinted by Next.js; safe to cache forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Product images are affiliate-network CDN URLs — do not cache here
/product/*
  Cache-Control: public, max-age=3600