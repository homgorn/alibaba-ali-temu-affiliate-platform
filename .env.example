# ============================================================================
#  ENVIRONMENT TEMPLATE
# ============================================================================
#
#  HOW TO USE
#    1. cp .env.example .env      (Windows: copy .env.example .env)
#    2. Fill in the values you have. Leave the rest blank.
#    3. Restart anything that reads them.
#
#  WHY THIS FILE IS SAFE TO COMMIT AND .env IS NOT
#    This file contains NO values — only names and documentation.
#    `.env` is gitignored and must never be committed.
#
#  THE KEY RULE OF THIS PROJECT
#    The engine MUST start, ingest CSV fixtures, and serve lookups with ZERO
#    credentials set (SPEC-001 FR-7 / NFR-8). Credentials unlock *live data*
#    and *deployment*. They are never required to develop or verify.
#    So: fill these in whenever you have them. Nothing breaks if you don't.
#
#  STATUS LEGEND
#    [BLOCKING]  Needed for the first real commission (F027)
#    [PHASE-1]   Needed for Phase 1 engine work, not blocking
#    [PHASE-4]   Needed for distribution/deployment
#    [OPTIONAL]  Nice to have; system degrades gracefully without it
#
# ============================================================================


# ============================================================================
#  BLOCK 1 — ALIEXPRESS AFFILIATE API  [BLOCKING]
# ============================================================================
#
#  Access path (see docs/wiki/20-affiliate-programs/ALIEXPRESS-AFFILIATE.md):
#    1. AliExpress account -> Portals -> apply with real traffic info
#       -> manual review
#    2. Open Platform developer account at console.aliexpress.com
#    3. Create app of type "Affiliate API"  (NOT "Dropship" - separate scopes)
#    4. Business licence reportedly required
#    5. App is created WITHOUT a secret in AliExpress's newer flow - the app
#       itself is the credential. Older apps use app_key + app_secret.
#       Check which one your app shows.
#
#  VERIFY FIRST WITH THE FREE TEST ENDPOINT:
#    aliexpress.cutflow.test   - costs nothing, proves auth works.
#    Only then call affiliate.hotproduct.download.

#  WHERE TO GET THESE:
#    Affiliate acct ........ https://portals.aliexpress.com/  (apply, wait for approval)
#    Developer console ..... https://console.aliexpress.com/  (create AppKey app)
#    Your API docs ......... http://openservice.aliexpress.com/doc/api.htm

# App key issued by the Taobao Open Platform.
# From console.aliexpress.com -> your app -> AppKey
ALIEXPRESS_APP_KEY=

# App secret. NOT present on apps created via the newer no-secret flow.
# If your app shows only an AppKey, leave this BLANK - that is correct.
ALIEXPRESS_APP_SECRET=

# Your affiliate/publisher identifier. Appears as the Affiliate ID (AID) in
# the Portals dashboard. This is what commissions are attributed to.
# NOT the same as the app key.
# GET IT AT: https://portals.aliexpress.com/  (top-of-page Affiliate ID)
ALIEXPRESS_AFFILIATE_ID=

# Region-specific API host. Verified from vendor docs; see
# docs/wiki/30-api-reference/ALIEXPRESS-API.md
#   US  -> api.taobao.com
#   EU  -> de-api.aliexpress.com
#   RU  -> ru-api.aliexpress.com
# Leave blank to use the default gateway.
ALIEXPRESS_API_HOST=

# Partner tracking id used in outbound deep links. If you only have one
# publisher account, this is usually the same as ALIEXPRESS_AFFILIATE_ID.
ALIEXPRESS_PUBLISHER_ID=

# ---------------------------------------------------------------------------
# Request budgeting (SPEC-001 FR-14)
# ---------------------------------------------------------------------------
# The daily quota is NOT publicly documented (open gap G3). A 2025 secondary
# source suggested ~5,000 requests/day — UNVERIFIED, treat as a hint only.
#
# SAFETY: there is NO sandbox. Every request hits production and consumes
# quota. Set this deliberately low until you have measured the real limit.
#
#   50   = safe starting point for first experiments
#   5000 = what one secondary source claims (unverified)
#   0    = unlimited (NOT recommended — can get you blocked)
ALIEXPRESS_DAILY_REQUEST_BUDGET=50


# ============================================================================
#  BLOCK 2 — AMAZON ASSOCIATES / CREATORS API  [PHASE-4]
# ============================================================================
#
#  ⚠️ CRITICAL: do NOT target PA-API 5. It is deprecated and now returns
#     AccessDenied. Verified 2026-10-08 — see docs/wiki/20-affiliate-programs/NETWORKS-LANDSCAPE.md
#     Target the Creators API instead.
#
#  Note: Amazon's affiliate programme is restricted to certain countries.
#  Eligibility and exact field requirements are UNVERIFIED (gap G20) —
#  the docs require an authenticated Associates account to read.

# Associates account access key. From Associates Central -> API registration.
# GET IT AT: https://affiliate-program.amazon.com/ (join) -> Associates Central ->
#            Tools -> Product Advertising API / API registration
AMAZON_CREATORS_ACCESS_KEY=

# Associates secret key for that access key.
AMAZON_CREATORS_SECRET_KEY=

# Your Associates tracking ID. Format is typically "<your-tag>-20".
# NOTE: the trailing "-20" encodes a specific programme/site and may differ
# for other programmes. Read it from your dashboard, do not assume.
# GET IT AT: https://affiliate-program.amazon.com/ join (or https://associates.amazon.com/)
AMAZON_CREATORS_TAG_ID=

# Amazon marketplace host per locale. Creators API requires a per-marketplace
# endpoint + region pairing (verified from vendor docs).
# Common: www.amazon.com, www.amazon.co.uk, www.amazon.de, www.amazon.co.jp
AMAZON_CREATORS_MARKETPLACE=

AMAZON_CREATORS_REGION=us-east-1


# ============================================================================
#  BLOCK 3 — DEPLOYMENT (Cloudflare)  [PHASE-4]
# ============================================================================
#
#  Hosting decision: Cloudflare Pages + Workers.
#  UNVERIFIED (risk R-016): whether Pages accepts payment from a Russian ИП,
#  and whether Workers can reach affiliate APIs from datacenter IPs — some
#  affiliate APIs block datacenter ranges. Test before relying on it.

# GET IT AT: https://dash.cloudflare.com/  ->  your account -> Workers & Pages -> Account ID
CLOUDFLARE_ACCOUNT_ID=

# API token with "Workers Scripts:Edit" + "Pages:Edit" + "Zone:Read".
# Create at dashboard -> My Profile -> API Tokens. Do NOT use the Global API Key.
# GET IT AT: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_TOKEN=

# Zone (domain) ID. Only needed for custom domains, not for *.pages.dev.
CLOUDFLARE_ZONE_ID=

# Custom domain for the site, if using one.
CLOUDFLARE_CUSTOM_DOMAIN=


# ============================================================================
#  BLOCK 4 — ANALYTICS & TRACKING  [PHASE-4]  ← ISSUE #2
# ============================================================================
#
#  ⚠️ THIS IS A ROADMAP GAP (M1), NOT A NICE-TO-HAVE.
#  Unit economics are currently unmeasurable (gap G25) and decision D-020
#  forbids paid-traffic spend until EPC is measured. Tracking is a PREREQUISITE
#  for ever measuring it.
#
#  The only metrics that matter:
#    - clicks per channel
#    - conversion joined back to the originating click
#    - commission reconciliation per order
#    - conversions outside the cookie window (3 days on AliExpress)
#
#  OPERATOR DECISION PENDING: whether to adapt an open-source tracker
#  (Keitaro-class) or build minimal in-house. See issue #2.

# Self-hosted analytics endpoint, if used (e.g. Plausible/Fathom instance).
ANALYTICS_ENDPOINT=

# Public site URL, used to scope analytics and generate absolute links.
PUBLIC_SITE_URL=https://example.pages.dev

# Salt used to hash visitor identifiers before storage. MUST be random and
# unique per deployment — reusing it across sites links visitors between them.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SALT=

# Cloudflare Web Analytics (free, cookie-free, no personal data) — alternative
# to a full tracker. Note: gives traffic data, NOT conversion attribution.
CLOUDFLARE_ANALYTICS_BEACON_TOKEN=


# ============================================================================
#  BLOCK 5 — TELEGRAM BOT  [PHASE-4]  (feature F022)
# ============================================================================
#
#  Get a token from @BotFather via /newbot. Token format: 123456:ABC-DEF...
#  The bot can only read messages in chats where it has been added.
#  GET IT AT: https://t.me/BotFather  -> /newbot
TELEGRAM_BOT_TOKEN=

# Optional: restrict to specific chat/user IDs. Strongly recommended for a
# price-alert bot, since it sends unsolicited messages otherwise.
TELEGRAM_ALLOWED_CHAT_IDS=


# ============================================================================
#  BLOCK 6 — SOCIAL PUBLISHING (Postiz / etc.)  [PHASE-4]
# ============================================================================
#
#  Postiz is self-hosted and open-source. UNVERIFIED: API stability, whether it
#  runs cleanly on Workers, which networks support programmatic posting, and
#  each platform's rules on automated posting. Check ToS per platform before
#  automating anything.
#  SELF-HOST: https://postiz.com/  (open-source, Docker) -> your API URL + key

POSTIZ_API_URL=
POSTIZ_API_KEY=

# Per-platform credentials. Fill only the ones you actually use.
# Store each as its own variable; never bundle them into one JSON blob.
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_TELEGRAM_BOT_NAME=


# ============================================================================
#  BLOCK 7 — LLM (offer selection, content)  [OPTIONAL]
# ============================================================================
#
#  The engine does NOT need an LLM to work, and this is a design decision, not
#  a limitation. See docs/wiki/30-api-reference/ALIEXPRESS-API.md:
#
#  commission_rate, sale_price, original_price, evaluate_rate, lastest_volume
#  and category ALL arrive in the same feed record. Margin and quality ranking
#  should therefore be DETERMINISTIC — no model in the loop.
#
#  An LLM should be used only for genuinely language-shaped work: writing the
#  narrative for why a product suits an audience, or phrasing honest caveats.
#  Asking a model to do arithmetic it can read is slower, less reproducible,
#  and a source of silent errors.
#
#  Because of that: you can ship the whole engine with this EMPTY.

# Provider: openrouter | openai | anthropic | ollama
LLM_PROVIDER=openrouter

# Provider API key. Leave empty to run fully without LLM features.
LLM_API_KEY=

# Model id. Used ONLY for narrative tasks, never for margin computation.
LLM_MODEL=


# ============================================================================
#  BLOCK 8 — CI / AUTOMATION  [PHASE-2]
# ============================================================================
#
#  Needed only for GitHub Actions. Create a fine-grained PAT with repo scope.
#  Alternatively configure this in GitHub's own repository secrets UI, which is
#  PREFERRED - then delete this entry entirely.
#  GET IT AT: https://github.com/settings/tokens -> Fine-grained tokens -> "repo" scope
#
#  SECURITY: a token in a workflow file or committed .env is a leaked token.

GITHUB_TOKEN=

# Optional: token used by research tooling for GitHub API reads.
GITHUB_RESEARCH_TOKEN=


# ============================================================================
#  BLOCK 9 — DATABASE  [PHASE-1]
# ============================================================================
#
#  Dev uses SQLite (no Docker on this machine — see decision D-005).
#  Prod uses Postgres. Schema stays Postgres-compatible; changing the driver
#  should be the ONLY difference.
#
#  SQLite path is relative to the repo root.

DATABASE_URL=file:./data/dev.db

# Postgres, for production or when Docker becomes available.
# DATABASE_URL=postgresql://user:password@localhost:5432/affiliate
DATABASE_SCHEMA=public

# Statement timeout in ms. Prevents a runaway query from hanging a Worker.
DATABASE_STATEMENT_TIMEOUT_MS=5000


# ============================================================================
#  BLOCK 10 — SAFETY-CRITICAL CATEGORY EXCLUSIONS  [PHASE-1]
# ============================================================================
#
#  Decision D-012: these categories are EXCLUDED OUTRIGHT, not warned about.
#  Batteries, chargers, PPE and baby goods are the named examples. A safety
#  failure injures someone; a warning alongside an affiliate link creates
#  liability with no offsetting benefit.
#
#  ⚠️ SPEC-001 EC-11: the engine REFUSES TO START if this list is empty.
#  An empty list silently disables the safety control — that is why it is a
#  hard startup failure rather than a warning.
#
#  Comma-separated category keywords, matched case-insensitively against the
#  product's category path. Review and extend this list deliberately.

SAFETY_EXCLUDED_CATEGORIES=battery,batteries,charger,chargers,power bank,powerbank,lithium,ppe,gloves,helmet,car seat,stroller,baby,infant,toddler,crib,child safety


# ============================================================================
#  BLOCK 11 — DATA RETENTION  [PHASE-1]
# ============================================================================
#
#  Decision D-013: retention is a first-class schema concern, because affiliate
#  API terms may forbid long-term storage. Discovering that AFTER the schema is
#  built forces a rewrite.
#
#  ⚠️ These are SAFE DEFAULTS chosen conservatively. They are NOT sourced from
#  the actual ToS — that extraction is open gap M6. Tighten when known.
#  See docs/wiki/80-legal-compliance/API-TOS-CONSTRAINTS.md

# Raw catalogue rows — kept shortest, most exposed to a ToS retention clause.
RETENTION_CATALOGUE_DAYS=30

# Price history — the basis of the core product, so kept longer.
RETENTION_PRICE_HISTORY_DAYS=365

# Derived aggregates — computed, not raw, so least ToS-exposed.
RETENTION_AGGREGATE_DAYS=1095


# ============================================================================
#  SAFETY CHECK
# ============================================================================
#  Before committing, confirm no secret is staged:
#      node scripts/agents-doctor.mjs
#  It scans for key-shaped strings and refuses dispatch if it finds any.
#
#  If a secret IS ever committed: rotate it FIRST at the provider, then rewrite
#  history. Removing it from the working tree afterwards does NOT undo exposure.
# ============================================================================
