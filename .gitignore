# ---- Secrets & credentials -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*_rsa
secrets/
credentials/
config/local/
# Affiliate API keys MUST never enter git
*aliexpress*key*
*app_secret*
apps_secret_*
*_private_token*

# ---- Node / pnpm -----------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
dist/
build/
.next/
.nuxt/
.output/
*.tsbuildinfo
coverage/
.nyc_output/

# ---- Python / uv -----------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/

# ---- Rust (if a fast scraper/parser is needed) -----------------------------
target/
Cargo.lock

# ---- Go --------------------------------------------------------------------
*.exe
*.test

# ---- Databases -------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# NOTE: `data/*` not `data/` — git does not descend into an ignored DIRECTORY,
# so a `data/` rule would make `!data/.gitkeep` unreachable.
data/*
!data/.gitkeep
*.sql.gz
dump/

# ---- Local env & runtime ---------------------------------------------------
tmp/
.cache/
logs/local/
*.log
!docs/logs/**/*.md

# ---- Research raw cache (keep reports, drop bulky raw fetches) ------------
# Raw source captures are committed for auditability, but binary/PDF caches are not.
research/raw/**/*.pdf
research/raw/**/*.har
research/raw/**/assets/

# ---- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ---- Build artefacts -------------------------------------------------------
out/
target/
*.blend1
*.blend2

# ---- Throwaway investigation scripts ---------------------------------------
# Probes written while diagnosing a specific issue. One-off by nature, useless
# a week later, and they get committed by accident because they sit next to the
# real scripts. The files stay on disk (R1: never delete) and are simply not
# tracked.
scripts/_scratch/
